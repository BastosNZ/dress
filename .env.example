# Copie para .env e troque as senhas. O .env está no .gitignore.
# Usado pelo docker-compose.yml da raiz.

# Banco
DB_NAME=dress
DB_USER=dress
DB_PASSWORD=troque_senha_do_banco
DB_ROOT_PASSWORD=troque_senha_root_do_banco

# API
JWT_SECRET=troque_por_uma_frase_longa_e_aleatoria
JWT_EXPIRES_IN=1h

# Primeiro administrador (criado só se o banco não tiver nenhum ADMIN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha

# Portas no seu computador
BACKEND_PORT=3000
FRONTEND_PORT=8501

# Deixe vazio pra buildar local. Preencha (ex.: 1.1.0) pra usar a imagem do GHCR.
# APP_VERSION=
