# Copie para .env e PREENCHA as senhas (vazias o compose não sobe).
# O .env está no .gitignore, nunca vai pro GitHub.
# Usado pelo docker-compose.yml da raiz.

# Banco
DB_NAME=dress
DB_USER=dress
DB_PASSWORD=
DB_ROOT_PASSWORD=

# API
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Primeiro administrador (criado só se o banco não tiver nenhum ADMIN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Portas no seu computador
BACKEND_PORT=3000
FRONTEND_PORT=8501

# Deixe vazio pra buildar local. Preencha (ex.: 1.1.0) pra usar a imagem do GHCR.
# APP_VERSION=
